{
  "info": {
    "_postman_id": "13aaf6a1-6388-4b27-9b12-82a45c627721",
    "name": "Pennywise Expense Tracker API",
    "description": "CRUD, reporting filters, budget management, and health checks for the Spring Boot API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "expenseId", "value": "1" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "pennywise" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('ok');"], "type": "text/javascript" } }]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "List this month's expenses",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/expenses?month=2026-11" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Expense list loads', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"], "type": "text/javascript" } }]
        },
        {
          "name": "Create expense",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Coffee\",\n  \"category\": \"Food & dining\",\n  \"amount\": 4.50,\n  \"spentOn\": \"2026-11-06\",\n  \"paymentMethod\": \"Card\",\n  \"note\": \"Cafe\"\n}" }, "url": "{{baseUrl}}/api/expenses" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Expense created', () => pm.response.to.have.status(201));", "const expense = pm.response.json();", "pm.collectionVariables.set('expenseId', expense.id);", "pm.expect(expense.title).to.eql('Coffee');"], "type": "text/javascript" } }]
        },
        {
          "name": "Update expense",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Coffee and tea\",\n  \"category\": \"Food & dining\",\n  \"amount\": 6.00,\n  \"spentOn\": \"2026-11-06\",\n  \"paymentMethod\": \"Card\",\n  \"note\": \"Updated from Postman\"\n}" }, "url": "{{baseUrl}}/api/expenses/{{expenseId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Expense updated', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().title).to.eql('Coffee and tea');"], "type": "text/javascript" } }]
        },
        {
          "name": "Delete expense",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/expenses/{{expenseId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Expense deleted', () => pm.response.to.have.status(204));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "List budgets",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/budgets" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Budget list loads', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"], "type": "text/javascript" } }]
        },
        {
          "name": "Save budgets",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"limits\": {\n    \"Food & dining\": 480,\n    \"Shopping\": 300,\n    \"Transport\": 220,\n    \"Entertainment\": 140,\n    \"Health\": 160,\n    \"Bills & utilities\": 240,\n    \"Travel\": 300,\n    \"Other\": 100\n  }\n}" }, "url": "{{baseUrl}}/api/budgets" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Budgets saved', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"], "type": "text/javascript" } }]
        }
      ]
    }
  ]
}
